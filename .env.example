# Base URL of the self-hosted WordPress site powering /resources.
# Must expose the default WP REST API at {url}/wp-json/wp/v2/ (public, no auth).
# Example: https://blog.smilereachmarketing.com
WORDPRESS_API_URL=

# Resend API key, used to email the contact form submissions to the team.
# Get one at https://resend.com/api-keys
# Until a domain is verified in Resend, delivery is restricted to the email
# address on the Resend account itself, see src/app/contact/actions.ts.
RESEND_API_KEY=
